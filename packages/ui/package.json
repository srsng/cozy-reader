{
	"name": "@cozy/ui",
	"version": "0.0.0",
	"description": "Cozy Reader Component Library",
	"keywords": [
		"components",
		"documentation",
		"Svelte",
		"SvelteKit"
	],
	"type": "module",
	"scripts": {
		"dev:ui": "vite dev",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "pnpm check --watch",
		"dev:package:svelte": "svelte-kit sync && svelte-package --watch",
		"package": "pnpm run --sequential \"/^package:.*/\"",
		"package:svelte": "svelte-kit sync && svelte-package",
		"prepare": "svelte-kit sync",
		"storybook": "storybook dev --no-open -p 6006",
		"storybook:build": "storybook build"
	},
	"devDependencies": {
		"@codemirror/lang-cpp": "^6.0.3",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.9",
		"@codemirror/lang-java": "^6.0.2",
		"@codemirror/lang-javascript": "^6.2.4",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.3.4",
		"@codemirror/lang-php": "^6.0.2",
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/lang-rust": "^6.0.2",
		"@codemirror/lang-vue": "^0.1.3",
		"@codemirror/lang-wast": "^6.0.2",
		"@codemirror/lang-xml": "^6.1.0",
		"@codemirror/language": "^6.11.2",
		"@codemirror/legacy-modes": "^6.5.1",
		"@internationalized/date": "^3.9.0",
		"@lezer/common": "^1.2.3",
		"@lezer/highlight": "^1.2.1",
		"@lucide/svelte": "^0.515.0",
		"@replit/codemirror-lang-svelte": "^6.0.0",
		"@storybook/addon-docs": "catalog:storybook",
		"@storybook/addon-links": "catalog:storybook",
		"@storybook/addon-svelte-csf": "catalog:storybook",
		"@storybook/addon-vitest": "catalog:storybook",
		"@storybook/experimental-addon-test": "catalog:storybook",
		"@storybook/sveltekit": "catalog:storybook",
		"@sveltejs/adapter-static": "catalog:svelte",
		"@sveltejs/kit": "catalog:svelte",
		"@sveltejs/package": "catalog:svelte",
		"@sveltejs/vite-plugin-svelte": "catalog:svelte",
		"@tailwindcss/forms": "catalog:shadcn-ui",
		"@tailwindcss/typography": "catalog:shadcn-ui",
		"@tailwindcss/vite": "catalog:shadcn-ui",
		"@tanstack/table-core": "^8.21.3",
		"@types/diff-match-patch": "^1.0.36",
		"autoprefixer": "^10.4.21",
		"bits-ui": "^2.9.7",
		"clsx": "catalog:shadcn-ui",
		"dayjs": "^1.11.13",
		"embla-carousel-svelte": "^8.6.0",
		"formsnap": "^2.0.1",
		"layerchart": "2.0.0-next.27",
		"marked": "catalog:",
		"mdsvex": "catalog:",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"storybook": "catalog:storybook",
		"svelte": "catalog:svelte",
		"svelte-check": "catalog:svelte",
		"svelte-sonner": "^1.0.5",
		"sveltekit-superforms": "^2.27.1",
		"tailwind-merge": "catalog:shadcn-ui",
		"tailwind-variants": "^1.0.0",
		"tailwindcss": "catalog:shadcn-ui",
		"tw-animate-css": "catalog:shadcn-ui",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "catalog:"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./*.svelte": {
			"svelte": "./dist/*.svelte",
			"types": "./dist/*.svelte.d.ts"
		},
		"./*": [
			{
				"import": "./dist/components/ui/*/index.js",
				"types": "./dist/components/ui/*/index.d.ts"
			},
			{
				"import": "./dist/*.js",
				"types": "./dist/*.d.ts"
			},
			{
				"svelte": "./dist/components/ui/*.svelte",
				"types": "./dist/components/ui/*.svelte.d.ts"
			}
		],
		"./*.css": {
			"import": "./dist/themes/*.css"
		},
		"./*.json": {
			"import": "./dist/*.json",
			"types": "./dist/*.json"
		}
	},
	"files": [
		"./dist/*.svelte",
		"./dist/*.json",
		"./dist/*.js",
		"./dist/*.json",
		"./dist/*.d.ts",
		"!./dist/*.test.*",
		"./dist/*.css",
		"./dist/styles/fonts/**/*.woff2"
	],
	"dependencies": {
		"@giphy/js-fetch-api": "^5.7.0",
		"@giphy/js-types": "^5.1.0",
		"@giphy/svelte-components": "^1.1.0",
		"@lexical/link": "0.27.1",
		"@lexical/list": "0.27.1",
		"@lexical/markdown": "0.27.1",
		"@lexical/rich-text": "0.27.1",
		"@lexical/selection": "0.27.1",
		"@lexical/text": "0.27.1",
		"@lexical/utils": "0.27.1",
		"emojibase": "^16.0.0",
		"emojibase-data": "^16.0.3",
		"lexical": "0.27.1",
		"svelte-lexical": "0.5.3"
	}
}
