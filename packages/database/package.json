{
    "name": "@cozy-reader/database",
    "version": "0.1.0",
    "description": "Database types and services for Cozy Reader",
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "db:gen:books": "drizzle-kit generate --config=drizzle/books/drizzle.config.ts && tsx scripts/append-triggers.ts books",
        "db:gen:all": "pnpm db:gen:books"
    },
    "devDependencies": {
        "@tauri-apps/api": "catalog:tauri",
        "@vitest/coverage-v8": "catalog:",
        "tsx": "^4.19.2",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "dependencies": {
        "@tauri-apps/plugin-sql": "catalog:tauri",
        "drizzle-kit": "^0.31.7",
        "drizzle-orm": "^0.44.7",
        "zod": "^4.1.13"
    }
}
