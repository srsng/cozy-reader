          "name": "books_constraints_check",
          "value": "\"books\".\"total_characters\" >= 0 AND \"books\".\"read_characters\" >= 0 AND \"books\".\"read_characters\" <= \"books\".\"total_characters\" AND \"books\".\"file_size\" >= 0"
        }
